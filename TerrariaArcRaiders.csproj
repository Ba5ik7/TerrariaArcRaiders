<Project Sdk="Microsoft.NET.Sdk">

	<!-- Import tModLoader mod properties -->
	<!-- Skip tModLoader packaging when running headless tests (BuildTests=true) to avoid invoking game build targets. -->
	<Import Project="..\tModLoader.targets" Condition="'$(BuildTests)'!='true'" />

	<!-- General -->
	<PropertyGroup>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<BuildTests>false</BuildTests>
	</PropertyGroup>

	<!-- Test-only build settings (headless, no tML targets) -->
	<PropertyGroup Condition="'$(BuildTests)'=='true'">
		<TargetFramework>net8.0</TargetFramework>
		<IsPackable>false</IsPackable>
		<DefineConstants>$(DefineConstants);BUILD_TESTS</DefineConstants>
	</PropertyGroup>

	<!-- Compile items for normal mod build -->
	<ItemGroup Condition="'$(BuildTests)'!='true'">
		<Compile Include="TerrariaArcRaiders.cs" />
		<Compile Include="Core\**\*.cs" />
		<Compile Include="Adapters\**\*.cs" />
	</ItemGroup>

	<!-- Compile items for headless test build -->
	<ItemGroup Condition="'$(BuildTests)'=='true'">
		<Compile Include="Core\**\*.cs" />
		<Compile Include="Adapters\Systems\ArcWorldDataBridge.cs" />
		<Compile Include="Tests\Unit\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="3.2.2" />
		<PackageReference Include="MSTest.TestFramework" Version="3.2.2" />
	</ItemGroup>

</Project>